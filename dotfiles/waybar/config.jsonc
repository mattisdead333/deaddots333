{
    "layer": "top",
    "margin-top": 5,
    "modules-left": [
        "clock",
        "hyprland/window"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "custom/kitty",
        "network",
        "pulseaudio"
    ],
    "clock": {
        "format-alt": "{:%a, %d. %b  %H:%M}"
    },
    "hyprland/workspaces": {
        "all-outputs": false,
        "format": "{name}",
        "persistent-workspaces": {
            "DP-3": 3, // 5 workspaces by default on every monitor
            "HDMI-A-1": 3 // but only three on HDMI-A-1
        }
    }
},
"hyprland/window": {
    "format": "{}",
    "separate-outputs": true
},
"pulseaudio": {
    "format": "{volume}% {icon}",
    "format-bluetooth": "{volume}% {icon}",
    "format-muted": "",
    "format-icons": {
        "alsa_output.pci-0000_00_1f.3.analog-stereo": "",
        "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
        "headphone": "",
        "hands-free": "",
        "headset": "",
        "phone": "",
        "phone-muted": "",
        "portable": "",
        "car": "",
        "default": [
            "",
            ""
        ]
    }
    "scroll-step": 1,
    "on-click": "pavucontrol",
    "ignored-sinks": [
        "Easy Effects Sink"
    ]
},
"network": {
    "interface": "enp6s0",
    "format": "{ifname}",
    "format-wifi": "{essid} ",
    "format-ethernet": "Online ",
    "format-disconnected": "", //An empty format will hide the module.
    "tooltip-format": "{ifname} via {gwaddr} ",
    "tooltip-format-wifi": "{essid} ({signalStrength}%) ",
    "tooltip-format-ethernet": "{ifname} ",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
    "on-click": "nm-connection-editor"
},
"custom/kitty": {
    "format": " {}",
    "interval": "once",
    "exec": "checkupdates | wc -l",
    "on-click": "kitty --hold yay -Syu",
    "signal": 8,
    "tooltip_format": "{} updates available"
},